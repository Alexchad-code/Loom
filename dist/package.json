{
  "name": "loom",
  "version": "1.0.0",
  "description": "A Roblox UI library: one file, thirty-three styles, every element.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/sourcemap.mjs && node tools/bundle.mjs",
    "icons": "node tools/icons.mjs",
    "icons:check": "node tools/icons.mjs --check",
    "analyze": "luau-lsp analyze --platform=roblox --definitions=types/globalTypes.d.luau --definitions=types/executor.d.luau --sourcemap=sourcemap.json src example.luau",
    "format": "stylua src tools example.luau",
    "format:check": "stylua --check src tools example.luau",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run format:check && npm run icons:check && npm run build && npm run analyze && npm run smoke"
  },
  "keywords": [
    "roblox",
    "luau",
    "ui",
    "exploit"
  ],
  "license": "MIT",
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "luau-lsp": "^1.0.0",
    "lucide-static": "^1.52.0"
  }
}
